# Copiar para .env (fora do git) e preencher. Gerar segredos com: openssl rand -hex 32
POSTGRES_PASSWORD=change-me
SESSION_SECRET=change-me-long-random
# Origens permitidas na verificação de Origin/CSRF, separadas por vírgulas.
# Em desenvolvimento, pode usar o wildcard explícito para URLs rotativos do ngrok.
# Em produção, prefira apenas o domínio final: https://o-teu-dominio
PUBLIC_ORIGIN=http://localhost:8080,http://127.0.0.1:8080,https://*.ngrok-free.app
# Cookie Secure: true em HTTPS; false apenas em desenvolvimento local por HTTP
COOKIE_SECURE=false
# Caddy: ":80" = só HTTP (rede local). Com um domínio (ex. arena.escola.pt) ativa HTTPS automático + HSTS
DOMAIN=:80
HTTP_PORT=8080
HTTPS_PORT=8443
# Conta inicial do professor (obrigatório mudar a palavra-passe no 1.º login)
TEACHER_USERNAME=professor
TEACHER_PASSWORD=change-me-too
WEB_CONCURRENCY=2
# Segredo partilhado app <-> runner (X-Runner-Token). Gerar com: openssl rand -hex 32
RUNNER_TOKEN=change-me-runner-token-0000000000
# CPUs do contentor do runner (a concorrência do sandbox acompanha este valor)
RUNNER_CPUS=2
