# Copiar para .env (fora do git) e preencher. Gerar segredos com: openssl rand -hex 32
POSTGRES_PASSWORD=change-me
SESSION_SECRET=change-me-long-random
# Endereço público exato (usado na verificação de Origin/CSRF). Em produção: https://o-teu-dominio
PUBLIC_ORIGIN=http://localhost:8080
# Cookie Secure: true em HTTPS; false apenas em desenvolvimento local por HTTP
COOKIE_SECURE=false
# Caddy: ":80" = só HTTP (rede local). Com um domínio (ex. arena.escola.pt) ativa HTTPS automático + HSTS
DOMAIN=:80
HTTP_PORT=8080
HTTPS_PORT=8443
# Conta inicial do professor (obrigatório mudar a palavra-passe no 1.º login)
TEACHER_USERNAME=professor
TEACHER_PASSWORD=change-me-too
WEB_CONCURRENCY=2
